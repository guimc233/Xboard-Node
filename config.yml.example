# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1

# ── Multiple instances ──
# kernel:
#   # mihomo is the only kernel (sing-box and Xray are retired).
#   type: "mihomo"
#   # Optional: path to the mihomo executable. Defaults to `mihomo` on PATH.
#   # binary_path: "/usr/local/bin/mihomo"
#   # Optional: a local mihomo document deep-merged over the generated config,
#   # for anything the panel does not model (dns, tun, proxy-groups, ...).
#   # custom_config: "/etc/xboard-node/mihomo-override.yaml"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only
